        <mxCell id="tp" value="&lt;b&gt;ThreadPool bulkhead cvParseBatch&lt;/b&gt;&lt;br&gt;3 thread + 17 hàng đợi · chạy trên bulkhead-cvParseBatch-*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="cvp"><mxGeometry x="20" y="185" width="390" height="60" as="geometry" /></mxCell>
        <mxCell id="reader" value="&lt;b&gt;MinioCvFileReader&lt;/b&gt;&lt;br&gt;đọc CV (UTF-8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cvp"><mxGeometry x="20" y="275" width="180" height="55" as="geometry" /></mxCell>
        <mxCell id="engine" value="&lt;b&gt;AnalysisEngine&lt;/b&gt;&lt;br&gt;5 slot dùng chung · BATCH 8s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="cvp"><mxGeometry x="230" y="275" width="180" height="55" as="geometry" /></mxCell>
        <mxCell id="analyze" value="&lt;b&gt;CvParseServiceImpl.analyze()&lt;/b&gt;&lt;br&gt;email, phone, skills, kinh nghiệm, học vấn…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cvp"><mxGeometry x="20" y="360" width="390" height="50" as="geometry" /></mxCell>
        <mxCell id="cvpnote" value="Container chỉ ack khi parse xong. Ngăn đầy → requeue sau 1s (không vào DLQ).&lt;br&gt;Tin nhắn chưa xử lý chờ an toàn trong RabbitMQ." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="cvp"><mxGeometry x="20" y="420" width="390" height="40" as="geometry" /></mxCell>
        <mxCell id="e1" value="&lt;b&gt;1&lt;/b&gt; · token (password grant)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="keycloak"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
