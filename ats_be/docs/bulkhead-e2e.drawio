          <mxGeometry x="20" y="155" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sema" value="&lt;b&gt;Semaphore bulkhead cvParseInteractive&lt;/b&gt;&lt;br&gt;2 permit · chờ tối đa 0,5s · chạy trên thread request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="cvp2">
