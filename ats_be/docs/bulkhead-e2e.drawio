        <mxCell id="legend" value="&lt;b&gt;Đọc sơ đồ&lt;/b&gt;&lt;br&gt;1 → 20: thứ tự thực thi thật trong code&lt;br&gt;Cam đậm: tin nhắn RabbitMQ · Xanh dương: ngăn ThreadPool bulkhead&lt;br&gt;Vàng: engine phân tích dùng chung (5 slot)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="460" height="80" as="geometry" /></mxCell>
