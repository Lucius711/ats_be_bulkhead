<mxfile host="app.diagrams.net" type="device">
  <diagram id="e2e-upload" name="1. Nộp CV → parse → kết quả (bất đồng bộ)">
    <mxGraphModel dx="1900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;E2E: nộp CV → RabbitMQ → cv-parse-service (ThreadPool bulkhead, bất đồng bộ) → kết quả&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="30" as="geometry" /></mxCell>
        <mxCell id="keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt; :8180&lt;br&gt;realm ats · client ats-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="eureka" value="&lt;b&gt;Eureka&lt;/b&gt; :8761" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="330" y="55" width="130" height="45" as="geometry" /></mxCell>
        <mxCell id="config" value="&lt;b&gt;Config Server&lt;/b&gt; :8888&lt;br&gt;config-repo/*.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;Tiếp nhận hồ sơ&lt;br&gt;localhost:3000 (demo-ui)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt; :8080&lt;br&gt;xác thực JWT → X-User-*&lt;br&gt;route lb://… qua Eureka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="reply" value="&lt;b&gt;8&lt;/b&gt; · 201 trả về ngay (~0,1–0,2 s) – người dùng không chờ parse" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#16a34a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="298" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="cand" value="candidate-service :8082" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="360" height="340" as="geometry" /></mxCell>
        <mxCell id="cctrl" value="&lt;b&gt;CandidateController&lt;/b&gt;&lt;br&gt;POST /api/v1/candidates (multipart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="cand"><mxGeometry x="20" y="40" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="csvc" value="&lt;b&gt;CandidateServiceImpl.saveWithCv()&lt;/b&gt;&lt;br&gt;@Transactional · lưu CV (PENDING) · upload MinIO&lt;br&gt;gửi lệnh parse &lt;b&gt;sau khi commit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="cand"><mxGeometry x="20" y="115" width="320" height="85" as="geometry" /></mxCell>
        <mxCell id="cres" value="&lt;b&gt;CvParseResultListener&lt;/b&gt;&lt;br&gt;→ PARSED, parsed_data, parsed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="cand"><mxGeometry x="170" y="245" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="minio" value="&lt;b&gt;MinIO&lt;/b&gt; :9000&lt;br&gt;bucket ats-cv" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="560" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;ats_candidate_dbs · cvs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="rmq" value="RabbitMQ :5672" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="250" height="340" as="geometry" /></mxCell>
        <mxCell id="exch" value="exchange &lt;b&gt;ats.cv.exchange&lt;/b&gt; (direct)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="rmq"><mxGeometry x="25" y="40" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="parseq" value="queue &lt;b&gt;ats.cv.parse.q&lt;/b&gt;&lt;br&gt;rk cv.parse · DLQ ats.cv.parse.dlq" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="rmq"><mxGeometry x="25" y="130" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="resq" value="queue &lt;b&gt;ats.cv.result.q&lt;/b&gt;&lt;br&gt;rk cv.result" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="rmq"><mxGeometry x="25" y="250" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="cvp" value="cv-parse-service :8085" style="swimlane;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="430" height="490" as="geometry" /></mxCell>
        <mxCell id="listener" value="&lt;b&gt;CvParseMessageListener&lt;/b&gt; @RabbitListener&lt;br&gt;prefetch 20 · ack MANUAL · trả CompletableFuture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cvp"><mxGeometry x="20" y="40" width="390" height="55" as="geometry" /></mxCell>
