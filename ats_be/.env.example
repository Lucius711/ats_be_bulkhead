# Copy this file to .env for local development.
# Do not commit .env: it may contain credentials or environment-specific values.

CONFIG_SERVER_PORT=8888
CONFIG_REPO_PATH=file:./config-repo
CONFIG_SERVER_URL=http://localhost:8888

EUREKA_URL=http://localhost:8761/eureka/

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dieunt
DB_PASSWORD=
JOB_DB_NAME=ats_job_dbs
CANDIDATE_DB_NAME=ats_candidate_dbs
APPLICATION_DB_NAME=ats_application_dbs
CV_PARSE_DB_NAME=ats_cvs_dbs

API_GATEWAY_PORT=8080
JOB_SERVICE_PORT=8081
CANDIDATE_SERVICE_PORT=8082
APPLICATION_SERVICE_PORT=8083
CV_PARSE_SERVICE_PORT=8083

JOB_SERVICE_URL=http://localhost:8081
CANDIDATE_SERVICE_URL=http://localhost:8082
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ats

# -----------------------------------------------------------------------------
# Nếu muốn dùng Git backend thật, đổi sang cấu hình dạng:
# CONFIG_SERVER_PROFILE=git
# CONFIG_GIT_URI=https://github.com/your-org/ats-be.git
# CONFIG_GIT_LABEL=main
# CONFIG_GIT_SEARCH_PATHS=config-repo
# CONFIG_GIT_USERNAME=your-git-username
# CONFIG_GIT_PASSWORD=your-git-token
#
# Đồng thời bỏ comment block `git:` trong:
# infras/config-server/src/main/resources/application.yml
#
# Cấu hình tương ứng trong Config Server:
# spring:
#   profiles:
#     active: git
#   cloud:
#     config:
#       server:
#         git:
#           uri: ${CONFIG_GIT_URI}
#           default-label: ${CONFIG_GIT_LABEL:main}
#           search-paths: ${CONFIG_GIT_SEARCH_PATHS:config-repo}
#           clone-on-start: true
#           refresh-rate: 60
#           username: ${CONFIG_GIT_USERNAME:}
#           password: ${CONFIG_GIT_PASSWORD:}
#
# Không commit Git password/token. Với GitHub, CONFIG_GIT_PASSWORD nên là PAT
# được inject từ secret manager hoặc biến môi trường runtime.
