# Copy to .env for local development.

# Infrastructure
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_PROFILE=native
CONFIG_REPO_PATH=file:./config-repo
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_PORT=8761
EUREKA_URL=http://localhost:8761/eureka/

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=dieunt
DB_PASSWORD=ats_dev_password
JOB_DB_NAME=ats_job_dbs
CANDIDATE_DB_NAME=ats_candidate_dbs
APPLICATION_DB_NAME=ats_application_dbs

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=ats
RABBITMQ_DEFAULT_PASS=ats_dev_password
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=ats
SPRING_RABBITMQ_PASSWORD=ats_dev_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_BUCKET=ats-cv

# Application ports
API_GATEWAY_PORT=8080
JOB_SERVICE_PORT=8081
CANDIDATE_SERVICE_PORT=8082
APPLICATION_SERVICE_PORT=8083
CV_PARSE_SERVICE_PORT=8085

JOB_SERVICE_URL=http://localhost:8081
CANDIDATE_SERVICE_URL=http://localhost:8082

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ats
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_JWK_SET_URI_DOCKER=http://keycloak:8080/realms/ats/protocol/openid-connect/certs
